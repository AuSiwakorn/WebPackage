RewriteEngine On

# โฟลเดอร์ที่ติดตั้งเว็บนี้ — ต้องตรงกับ $webBase ใน admweb/aowebdata/fix.<โดเมน>.php
# ย้ายไปไว้ที่ root ของโดเมนเมื่อไร ให้เปลี่ยนเป็น RewriteBase / (กฎด้านล่างเขียนแบบ relative ไม่ต้องแก้)
RewriteBase /aostock/

# หน้าแรกของโฟลเดอร์ = router index.php (→ themes/aostock/home.php → หน้า login)
DirectoryIndex index.php

# ใช้ชื่อโดเมนแบบไม่มี www. เท่านั้น (session ของ admweb / POS ผูกกับชื่อโดเมน)
RewriteCond %{HTTPS} =on
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

# ห้ามเรียกไฟล์ .php ใน themes/ ตรงๆ — ต้องผ่าน index.php เท่านั้น
# (asset/css/js/รูป ใน themes/ ยังเข้าได้ เพราะไม่ใช่ .php · router ที่ include ฝั่ง server ไม่กระทบ)
RewriteRule ^themes/.+\.php$ - [F]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
# Redirect /xxx/ to /xxx (ตัด / ท้ายออก)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# ปิดไฟล์ใน admweb/ ที่เว็บนี้ไม่ใช้ — ตั้งไว้ที่นี่แทนการแก้ / เพิ่มไฟล์ใน admweb/ (อัปเกรด admweb ได้ไม่ทับ)
#  phpinfo.php        : แสดงค่าตั้งเซิร์ฟเวอร์ทั้งหมด
#  api/post_*.php     : endpoint ฟอร์มของโปรเจกต์อื่น — post_ajax.php ต่อค่าจากฟอร์มเข้า SQL ตรง ๆ (SQL injection)
#  api/inc.php, api/api_lang.php, api/oApi.php : ใช้ include ฝั่ง server เท่านั้น / include ผิด path ใช้งานไม่ได้
#  (api/BACKUP/, api/MONITOR_SCAN/, api/THREAT/ ยังเปิด — ระบบ monitor ของ aosoft.co.th เรียกใช้)
RewriteRule ^admweb/(phpinfo|api/(post_[^/]+|inc|api_lang|oApi))\.php$ - [F,NC,L]

# ยกเว้น backend — ไม่ส่งเข้า router
RewriteRule ^admweb/ - [L]

# อย่าแตะไฟล์หรือโฟลเดอร์จริง
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ส่งทุกอย่างเข้า index.php โดยไม่ส่ง query string
RewriteRule ^ index.php [L]

# ป้องกันการเข้าถึงไฟล์สำคัญ (.md = เอกสารภายใน เช่น CLAUDE.md, ADMWEB.md, README.md · .sql = ไฟล์ข้อมูลทดสอบ / schema)
<FilesMatch "(\.env|\.git|config\.php|composer\.json|composer\.lock|\.md$|\.sql$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ป้องกันการเปิดดู directory (directory listing)
Options -Indexes
